{
  "manifest_version": 3,
  "name": "Vseosvita Focus Guard",
  "version": "1.5.0",
  "description": "Neutralizes focus and visibility control on vseosvita.ua",
  "key": "",
  "permissions": ["storage", "tabs", "management"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vseosvita Focus Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://vseosvita.ua/*", "*://*.vseosvita.ua/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": ["*://vseosvita.ua/*", "*://*.vseosvita.ua/*"]
    }
  ]
}
